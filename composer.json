{
    "name": "reliese/laravel-model-gen",
    "description": "Reliese Laravel model generator for database-driven Eloquent model scaffolding.",
    "keywords": [
        "reliese",
        "laravel",
        "model-generator",
        "eloquent"
    ],
    "homepage": "https://github.com/reliese/laravel-model-gen",
    "support": {
        "issues": "https://github.com/reliese/laravel-model-gen/issues",
        "source": "https://github.com/reliese/laravel-model-gen"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Cristian Llanos",
            "email": "cristianllanos@outlook.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "doctrine/dbal": ">=2.5",
        "illuminate/support": ">=5.1",
        "illuminate/database": ">=5.1",
        "illuminate/contracts": ">=5.1",
        "illuminate/filesystem": ">=5.1",
        "illuminate/console": ">=5.1"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": ">=1.4",
        "phpunit/phpunit": "^9"
    },
    "autoload": {
        "psr-4": {
            "Reliese\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reliese\\Coders\\CodersServiceProvider"
            ]
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/reliese"
        }
    ]
}
